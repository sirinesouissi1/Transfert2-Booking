# Server
PORT=5002
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/lumina_tunisia

# JWT
JWT_SECRET=change_me_with_a_long_random_value
JWT_EXPIRE=30d

# Email (Gmail avec mot de passe d'application, 16 caractères sans espaces)
EMAIL_USER=votre.adresse@gmail.com
EMAIL_PASS=mot_de_passe_application_16_caracteres
ADMIN_EMAIL=adresse.admin@exemple.com

# Optionnel : envoi par API Brevo (si le SMTP est bloqué en production)
# BREVO_API_KEY=
# EMAIL_FROM=votre.adresse@gmail.com

# Stripe (paiements)
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Frontend URL (CORS), plusieurs adresses possibles séparées par des virgules
CLIENT_URL=http://localhost:5173,http://localhost:5174
